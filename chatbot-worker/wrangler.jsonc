{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "sanchit-portfolio-chatbot",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-24",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "SITE_ORIGIN": "https://sanchitminocha.github.io",
    "ALLOW_LOCAL_PREVIEW": "true",
    "GROQ_MODEL": "openai/gpt-oss-20b"
  },
  "ratelimits": [
    {
      "name": "CHAT_LIMIT",
      "namespace_id": "1001",
      "simple": {
        "limit": 6,
        "period": 60
      }
    }
  ]
}
